# SakhiShield Environment Configuration Template
# Client-side variables (prefixed with VITE_) are exposed to Vite browser bundle.
# Sensitive server-side keys (like RESEND_API_KEY) must NEVER have a VITE_ prefix.

# Supabase Configuration
VITE_SUPABASE_URL=https://sxyfsdmnnvammaksdgml.supabase.co
VITE_SUPABASE_ANON_KEY=

# Mapbox Configuration (Geocoding & Directions)
VITE_MAPBOX_ACCESS_TOKEN=

# Firebase Cloud Messaging & Web Push (Client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Server-Side Only Secrets (Supabase Edge Functions / Backend)
# NEVER prefix with VITE_ or expose to browser client
RESEND_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
